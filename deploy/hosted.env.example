# Hosted tenant-node profile for aMail (AMAIL_KEY_MODE=keyslot).
#
# Copy these into the tenant compose / env on the SaaS node. The image also
# applies the same values when they are unset, so a tenant that only has
# AMAIL_KEY_MODE=keyslot still rolls out the density profile. Explicit
# environment always wins — drop OSS `.env.example` pins such as
# SYNC_INTERVAL_MINUTES=5 or LOG_LEVEL=info, or they will keep the OSS values.
#
# Self-hosted installs should keep using `.env.example`, not this file.

AMAIL_KEY_MODE=keyslot

# Failures only: no per-request pino-http lines.
LOG_LEVEL=error

# Unattended fallback when no focused tab is watching. Agents that need
# freshness call sync_mail first; a focused UI still syncs on focus.
SYNC_INTERVAL_MINUTES=15

# Smaller first-sync window (1–1000). Older history is not backfilled.
AMAIL_SYNC_BATCH_SIZE=100

# Maximum raw RFC822 bytes downloaded and parsed for one message (5 MiB).
AMAIL_SYNC_MAX_MESSAGE_BYTES=5242880

# Minimum time between IMAP syncs for the same accounts (milliseconds).
AMAIL_SYNC_MIN_INTERVAL_MS=60000

# Keep one IMAP connection per account this long after the last use.
AMAIL_IMAP_POOL_IDLE_MS=480000

# Accounts synchronized in parallel. One keeps a tenant to a single IMAP pass.
AMAIL_SYNC_CONCURRENCY=1

# Optional. Uncomment to drop stored html_body/text_body older than N days
# (headers, snippet, and flags stay). Leave unset or 0 to keep bodies forever.
# AMAIL_RETAIN_DAYS=90

# V8 heap cap and a smaller libuv pool. The image entrypoint sets these in
# keyslot mode when they are unset; listing them here makes the compose file
# the source of truth.
NODE_OPTIONS=--max-old-space-size=384
UV_THREADPOOL_SIZE=2
