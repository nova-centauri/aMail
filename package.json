{
  "name": "amail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aMail (Agentic Mail): a privacy-first, self-hosted multi-account mail client.",
  "license": "MIT",
  "homepage": "https://github.com/nova-centauri/aMail#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "npm run build && node --check server/index.js",
    "test": "node --test \"server/**/*.test.js\" && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.0",
    "undici": "8.10.0",
    "uuid": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "html-to-text": "10.0.1"
  }
}
