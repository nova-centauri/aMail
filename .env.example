# aMail (Agentic Mail) configuration.
#
# Copy this file to `.env`, replace the two required secrets, and run
# `sh deploy/launch.sh`. Every AMAIL_* variable also accepts the GigaMail-era
# GIGAMAIL_* name, so an existing GigaMail .env keeps working unchanged.

# Docker Compose project name. This scopes containers, networks, and volumes
# so this deployment never touches other Compose projects on the host. Use a
# distinct name if the same machine hosts more than one aMail installation.
COMPOSE_PROJECT_NAME=amail

# The browser-facing service binds only to the loopback interface by default.
# Access it through an SSH tunnel or an HTTPS reverse proxy (see
# deploy/README.md). If a reverse proxy on another host must reach this
# machine directly, bind only to its private address, never 0.0.0.0.
AMAIL_BIND_ADDRESS=127.0.0.1
AMAIL_PORT=3080

# Required: a high-entropy secret (for example: `openssl rand -hex 32`). It
# encrypts saved IMAP/SMTP credentials at rest. Never rotate it without first
# decrypting/re-encrypting the stored account credentials.
AMAIL_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Optional: also encrypt the whole SQLite file (mail bodies, search index,
# settings) with a key derived from AMAIL_ENCRYPTION_KEY. An existing plaintext
# database is migrated in place on the next start; take a backup first. Once
# on, the server refuses to start with it off (see deploy/README.md).
AMAIL_ENCRYPT_DATABASE=false

# Required: a separate high-entropy token used to authenticate browser, REST
# API, and MCP access. Generate with: openssl rand -hex 32
# Agents send it as `Authorization: Bearer <token>`.
AMAIL_ACCESS_TOKEN=replace-with-a-long-random-access-token

# Optional. If omitted, AMAIL_ENCRYPTION_KEY is used for short-lived remote
# content tokens. Use a separate value if you prefer key separation.
AMAIL_REMOTE_TOKEN_KEY=

# Default: leave empty. The privacy launch command temporarily sets this to
# http://tor-proxy:8118. In production, remote-content loading fails closed
# when this proxy is absent; it never silently falls back to a direct fetch.
REMOTE_CONTENT_PROXY_URL=

# Conservative server defaults.
# Set true only when aMail sits behind a reverse proxy you control, so the
# forwarded protocol and client address are trusted.
AMAIL_TRUST_PROXY=false
AMAIL_ALLOW_INSECURE_TLS=false
# Session cookies are Secure by default. Set false only for plain-HTTP access
# on a trusted LAN or through an SSH tunnel where HTTPS is not available.
AMAIL_COOKIE_SECURE=true
# The newest messages imported per folder during the initial sync (1–1000).
# Older history is not automatically backfilled; raise this before connecting
# an account if a larger recent window is needed.
AMAIL_SYNC_BATCH_SIZE=200
AMAIL_SYNC_TIMEOUT_MS=60000
# Maximum raw RFC822 bytes downloaded and parsed for one message (64 KiB–50
# MiB). Choose this before the first account sync: larger messages are skipped,
# and raising the cap later affects future messages rather than backfilling them.
AMAIL_SYNC_MAX_MESSAGE_BYTES=10485760
# Unattended fallback: poll enabled inboxes sequentially every five minutes
# when no focused mailbox tab is watching. A focused session syncs much more
# often (~15s) and checks every inbox immediately when it returns to the
# foreground. Set 0 to disable this server-side fallback.
SYNC_INTERVAL_MINUTES=5
AMAIL_REMOTE_CONTENT_MAX_BYTES=5242880
AMAIL_REMOTE_CONTENT_TIMEOUT_MS=12000
# Signed image capability URLs are short-lived and are never written to logs.
AMAIL_REMOTE_CONTENT_TOKEN_TTL=300
# Logs are JSON on stdout. Whatever the level, entries never carry headers,
# cookies, query strings, addresses, subjects, or bodies. `error` is the
# failures-only profile used for hosted tenants: no per-request entries at all.
LOG_LEVEL=info

# Smart filtering: comma-separated keywords that identify routine infrastructure
# digests from your own tooling (hostnames, product names, backup job names).
# Successful digests are hidden from the default inbox; failures surface under
# "Ops errors". Leave unset for the defaults, or set empty to disable.
# AMAIL_OPS_SOURCES=proxmox,watchtower,unraid,my-backup-job

# Passkeys (WebAuthn). Leave both empty to derive them from each request, which
# works for SSH tunnels and single-hostname setups. Behind a reverse proxy the
# container sees an internal Host, so pin the public HTTPS origin here:
#   AMAIL_RP_ID=mail.example.com
#   AMAIL_ORIGIN=https://mail.example.com
AMAIL_RP_ID=
AMAIL_ORIGIN=

# ---------------------------------------------------------------------------
# Hosted / multi-tenant plumbing. Every setting below is inert when unset, so a
# self-hosted install never needs to touch this section.
# ---------------------------------------------------------------------------

# Usage metering. When set, aMail POSTs batched JSON to this URL each time an
# agent (or person) marks mail analyzed: {"version":1,"tenant":..., "events":
# [{"type":"analyzed","count":N,"at":ISO,"until":ISO}]}. Counts and timestamps
# only; never message ids, subjects, addresses, or agent names.
AMAIL_METERING_URL=
AMAIL_METERING_TOKEN=
# Opaque identifier the metering endpoint uses to attribute events.
AMAIL_TENANT_ID=

# Key mode. `env` (default) keys everything from AMAIL_ENCRYPTION_KEY above and
# gates access with AMAIL_ACCESS_TOKEN. `keyslot` is the hosted model: leave
# both of those unset, the container boots locked, and a random data key that
# only the tenant's own credentials (bearer tokens, passphrase, passkey,
# recovery code) can unwrap encrypts the whole database. See deploy/README.md.
AMAIL_KEY_MODE=env
# Keyslot mode only. Authorizes the one-time POST /api/keyslots/init that
# creates the first token and the recovery code. Provisioning is disabled
# while this is unset.
AMAIL_PROVISION_SECRET=
# Keyslot mode only, optional. Operator key that an opted-in tenant's data key
# is wrapped under so the container can unlock itself after a restart.
# Tenants enable this per harness (POST /api/keyslots/escrow); default off.
AMAIL_ESCROW_KEY=
# Keyslot mode only, optional. Unix socket inside the data volume over which a
# running process hands its data key to a newly started one during a deploy,
# plus the secret both processes must share. Leave unset to disable.
AMAIL_HANDOFF_SOCKET=
AMAIL_HANDOFF_SECRET=
